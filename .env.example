# ------------------------------------------------------------------
# AI Expense Receipt Assistant: environment template
# Copy to `.env` and fill in. Never commit the real `.env`.
# Secrets are entered as n8n credentials; this file is the checklist.
# ------------------------------------------------------------------

# --- n8n instance (must be public HTTPS for Telegram webhooks) ---
N8N_HOST=n8n.yourcompany.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourcompany.com/
GENERIC_TIMEZONE=UTC
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Telegram ---
# Credential: "Expense Assistant · Telegram Bot" (token from @BotFather)
TELEGRAM_BOT_TOKEN=
FINANCE_APPROVER_CHAT_ID=

# --- OpenAI (vision model) ---
# Credential: "Expense Assistant · OpenAI API"
OPENAI_API_KEY=

# --- PostgreSQL ---
# Credential: "Expense Assistant · Postgres"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expenses
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# --- Gmail (monthly finance report) ---
# Credential: "Expense Assistant · Gmail (Finance)"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FINANCE_REPORT_EMAIL=finance@yourcompany.com

# --- Policy (mirror in the "Config · Expense Policy" node) ---
BASE_CURRENCY=USD
AUTO_APPROVE_LIMIT=250
MAX_RECEIPT_AGE_DAYS=90
CONFIDENCE_THRESHOLD=0.8
